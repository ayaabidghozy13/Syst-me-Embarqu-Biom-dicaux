        "func": "const uid = String(msg.payload || '').trim();\nif (!uid) return null;\nconst now = Date.now();\nconst previousUID = context.get('lastUID') || '';\nconst previousTime = context.get('lastTime') || 0;\n\n// Ignore le même badge relu en moins de 3 s.\nif (uid === previousUID && now - previousTime < 3000) return null;\n\ncontext.set('lastUID', uid);\ncontext.set('lastTime', now);\nflow.set('patientUID', uid);\nmsg.payload = '🪪 ' + uid;\nreturn msg;",
