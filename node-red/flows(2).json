    {
        "id": "60875c130bd0ba85",
        "type": "function",
        "z": "d5f84fe3c1ba01d0",
        "name": "Manual command (full state)",
        "func": "// Envoie toujours l'état COMPLET lampe/buzzer/fréquence à l'Arduino.\nconst cmd = String(msg.payload);\nlet lamp = Number(flow.get('lampState') || 0);\nlet buzzer = Number(flow.get('buzzerState') || 0);\nlet freq = Number(flow.get('freq') || 600);\n\nswitch (cmd) {\n    case 'lamp_on':    lamp = 1; flow.set('manualLampOverride', true); break;\n    case 'lamp_off':   lamp = 0; flow.set('manualLampOverride', false); break;\n    case 'buzzer_on':  buzzer = 1; freq = 1200; flow.set('manualBuzzerOverride', true); break;\n    case 'buzzer_off': buzzer = 0; flow.set('manualBuzzerOverride', false); break;\n    case 'all_off':\n        lamp = 0; buzzer = 0; freq = 600;\n        flow.set('manualLampOverride', null);\n        flow.set('manualBuzzerOverride', null);\n        break;\n    default: return null;\n}\nflow.set('lampState', lamp);\nflow.set('buzzerState', buzzer);\nflow.set('freq', freq);\n\nreturn [\n    { payload: 'lamp=' + lamp + ';buzzer=' + buzzer + ';frequency=' + freq },\n    { payload: '💡 Lampe ' + (lamp ? 'ON' : 'OFF') + ' · 🔊 Buzzer ' + (buzzer ? 'ON' : 'OFF') }\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
