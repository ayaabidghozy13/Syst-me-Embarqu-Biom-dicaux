    {
        "id": "ac4e5421fba021d5",
        "type": "function",
        "z": "d5f84fe3c1ba01d0",
        "name": "ECG processing + BPM estimate",
        "func": "let d = msg.payload;\nif (typeof d === 'string') {\n    try { d = JSON.parse(d); } catch (e) { return null; }\n}\nif (!d || !Number.isFinite(Number(d.raw))) return null;\n\nconst raw = Number(d.raw);\nconst now = Date.now();\n// État en contexte FLOW pour pouvoir être réinitialisé au start/stop.\nlet s = flow.get('ecgState') || { base: raw, prev: raw, armed: true, lastPeak: 0, leads: null };\n\n// Suivi lent de la ligne de base pour estimer la composante AC.\ns.base = s.base * 0.98 + raw * 0.02;\nconst ac = raw - s.base;\nconst prevAc = s.prev - s.base;\nconst threshold = 18; // À calibrer selon votre capteur ECG.\n\n// Estimation BPM sur front montant (pas un algorithme médical).\nlet bpmMsg = null;\nif (prevAc < threshold && ac >= threshold && s.armed) {\n    if (s.lastPeak > 0) {\n        const interval = now - s.lastPeak;\n        if (interval >= 300 && interval <= 2000) {\n            bpmMsg = { payload: Math.round(60000 / interval), topic: 'BPM' };\n        }\n    }\n    s.lastPeak = now;\n    s.armed = false;\n}\nif (ac < threshold * 0.4) s.armed = true;\ns.prev = raw;\n\n// Message électrodes uniquement quand l'état change.\nconst leadsOk = Number(d.lo_plus) === 0 && Number(d.lo_moins) === 0;\nlet leadMsg = null;\nif (s.leads !== leadsOk) {\n    s.leads = leadsOk;\n    leadMsg = { payload: leadsOk ? '🟢 Contact détecté' : '🔴 Vérifier les électrodes', topic: 'Electrode status' };\n}\nflow.set('ecgState', s);\n\nreturn [{ payload: raw, topic: 'ECG' }, bpmMsg, leadMsg, { payload: 'ecg', topic: 'heartbeat' }];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
