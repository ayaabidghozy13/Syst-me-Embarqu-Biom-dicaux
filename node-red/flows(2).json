        "order": 1,
        "width": 12,
        "height": 3,
        "head": "",
        "format": "<template>\n  <div class=\"hm-banner\">\n    <div class=\"hm-text\">\n      <div class=\"hm-title\">💙 CardioTrack — Votre cœur sous bonne garde</div>\n      <div class=\"hm-sub\">Suivi ECG en temps réel · Badge RFID · Arduino UNO R4 WiFi</div>\n      <svg class=\"hm-ecg\" viewBox=\"0 0 400 40\" preserveAspectRatio=\"none\">\n        <path d=\"M0 20 H90 L100 20 L108 6 L116 34 L124 12 L130 20 H210 L220 20 L228 6 L236 34 L244 12 L250 20 H330 L340 20 L348 6 L356 34 L364 12 L370 20 H400\" />\n      </svg>\n      <div class=\"hm-clock\">🕒 {{ now }}</div>\n    </div>\n\n    <!-- Illustration originale d'un médecin (SVG, aucune image externe) -->\n    <svg class=\"hm-doctor\" viewBox=\"0 0 160 160\" aria-label=\"Médecin\">\n      <circle cx=\"80\" cy=\"80\" r=\"78\" fill=\"#e0f2fe\"/>\n      <!-- blouse -->\n      <path d=\"M30 160 C30 118 50 104 80 104 C110 104 130 118 130 160 Z\" fill=\"#ffffff\" stroke=\"#cbd5e1\" stroke-width=\"2\"/>\n      <!-- tenue sous la blouse -->\n      <path d=\"M66 104 L80 132 L94 104 Z\" fill=\"#0ea5e9\"/>\n      <!-- revers de la blouse -->\n      <path d=\"M66 104 L80 132 L70 160 L56 160 Z\" fill=\"#f1f5f9\"/>\n      <path d=\"M94 104 L80 132 L90 160 L104 160 Z\" fill=\"#f1f5f9\"/>\n      <!-- cou -->\n      <rect x=\"72\" y=\"88\" width=\"16\" height=\"18\" rx=\"6\" fill=\"#f2c9a0\"/>\n      <!-- tête -->\n      <circle cx=\"80\" cy=\"66\" r=\"26\" fill=\"#f6d2ae\"/>\n      <!-- cheveux -->\n      <path d=\"M54 62 C54 40 70 34 82 36 C98 36 108 46 106 62 C100 52 90 48 78 50 C68 50 60 56 54 62 Z\" fill=\"#3f2d20\"/>\n      <!-- yeux + sourire -->\n      <circle cx=\"71\" cy=\"68\" r=\"2.6\" fill=\"#1e293b\"/>\n      <circle cx=\"89\" cy=\"68\" r=\"2.6\" fill=\"#1e293b\"/>\n      <path d=\"M72 78 Q80 85 88 78\" stroke=\"#1e293b\" stroke-width=\"2.4\" fill=\"none\" stroke-linecap=\"round\"/>\n      <!-- stéthoscope -->\n      <path d=\"M62 106 C58 124 64 136 76 138\" stroke=\"#334155\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\"/>\n      <path d=\"M98 106 C102 124 96 136 84 138\" stroke=\"#334155\" stroke-width=\"3.5\" fill=\"none\" stroke-linecap=\"round\"/>\n      <circle cx=\"80\" cy=\"140\" r=\"6\" fill=\"#94a3b8\" stroke=\"#334155\" stroke-width=\"2.5\"/>\n      <!-- badge croix -->\n      <rect x=\"104\" y=\"122\" width=\"16\" height=\"16\" rx=\"3\" fill=\"#ffffff\" stroke=\"#ef4444\" stroke-width=\"2\"/>\n      <path d=\"M112 125 V135 M107 130 H117\" stroke=\"#ef4444\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    </svg>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() { return { now: '', timer: null }; },\n  mounted() {\n    const tick = () => {\n      this.now = new Date().toLocaleString('fr-FR', { timeZone: 'Europe/Paris' });\n    };\n    tick();\n    this.timer = setInterval(tick, 1000);\n  },\n  unmounted() { clearInterval(this.timer); }\n};\n</script>\n\n<style>\n.hm-banner {\n  box-sizing: border-box; min-height: 140px;\n  display: flex; align-items: center; justify-content: space-between; gap: 16px;\n  padding: 18px 24px; border-radius: 12px; color: #ffffff;\n  background: linear-gradient(120deg, #0369a1 0%, #0ea5e9 55%, #22d3ee 100%);\n  box-shadow: 0 6px 18px rgba(14, 165, 233, 0.25);\n}\n.hm-text { flex: 1; min-width: 0; }\n.hm-title { font-size: clamp(20px, 3vw, 30px); font-weight: 700; line-height: 1.2; }\n.hm-sub { font-size: 14px; opacity: 0.9; margin-top: 4px; }\n.hm-clock { font-size: 13px; opacity: 0.9; margin-top: 6px; }\n.hm-ecg { width: 100%; max-width: 420px; height: 34px; margin-top: 8px; display: block; }\n.hm-ecg path {\n  fill: none; stroke: #ffffff; stroke-width: 2.5; stroke-linejoin: round;\n  stroke-dasharray: 600; stroke-dashoffset: 600;\n  animation: hm-draw 3s linear infinite;\n}\n@keyframes hm-draw { to { stroke-dashoffset: 0; } }\n.hm-doctor { width: 110px; height: 110px; flex-shrink: 0;\n  filter: drop-shadow(0 4px 10px rgba(0,0,0,0.2)); }\n@media (max-width: 576px) {\n  .hm-banner { padding: 14px; }\n  .hm-doctor { width: 80px; height: 80px; }\n}\n</style>",
