        "name": "Save BPM threshold",
        "func": "const value = Number(msg.payload);\nif (!Number.isFinite(value)) return null;\nconst threshold = Math.max(40, Math.min(180, Math.round(value)));\nflow.set('bpmThreshold', threshold);\nmsg.payload = '🎚️ ' + threshold + ' BPM';\nreturn msg;",
