    {
        "id": "2924334f1d05b016",
        "type": "function",
        "z": "d5f84fe3c1ba01d0",
        "name": "Patient card state",
        "func": "// Carte patient : badge RFID + état de la session\n// Se resynchronise aussi avec le heartbeat de l'Arduino (toutes les 2 s).\nconst t = String(msg.topic || '');\nconst p = String(msg.payload ?? '').trim();\nconst vide = { uid: null, time: '', status: '' };\nlet s = context.get('patient') || { ...vide };\nconst now = new Date().toLocaleTimeString('fr-FR', { timeZone: 'Europe/Paris' });\nconst avant = JSON.stringify(s);\n\nif (t === 'health/rfid') {\n    if (!p) return null;\n    s = { uid: p, time: now, status: 'identifie' };\n    flow.set('patientUID', p);\n} else if (t === 'health/button') {\n    const b = p.toLowerCase();\n    if (b === 'start' && s.uid) s.status = 'acquisition';\n    else if (b === 'stop') { s = { ...vide }; flow.set('patientUID', null); }\n    else return null;\n} else if (t === 'health/status') {\n    const st = p.toLowerCase();\n    const uid = s.uid || String(flow.get('patientUID') || '').replace('🪪', '').trim() || null;\n    if (st === 'attente badge') s = { ...vide };\n    else if (st === 'patient identifie' && uid) s = { uid, time: s.time || now, status: 'identifie' };\n    else if (st === 'acquisition en cours' && uid) s = { uid, time: s.time || now, status: 'acquisition' };\n    else return null;\n} else {\n    return null;\n}\n\ncontext.set('patient', s);\nif (JSON.stringify(s) === avant) return null;   // rien n'a changé\nreturn { payload: s };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 1410,
