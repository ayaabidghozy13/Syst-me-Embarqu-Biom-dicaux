    {
        "id": "f498977d7242b7f7",
        "type": "function",
        "z": "d5f84fe3c1ba01d0",
        "name": " BPM alarm — lamp + buzzer",
        "func": "const bpm = Number(msg.payload);\nif (!Number.isFinite(bpm) || bpm <= 0) return null;\nconst threshold = Number(flow.get('bpmThreshold') || 100);\nconst active = bpm >= threshold;\n// Contexte FLOW : réinitialisé quand l'acquisition s'arrête.\nif (flow.get('alarmActive') === active) return null;\nflow.set('alarmActive', active);\n\nlet lamp = 0, buzzer = 0, freq = 600;\nif (active) {\n    lamp = flow.get('manualLampOverride') === false ? 0 : 1;\n    buzzer = flow.get('manualBuzzerOverride') === false ? 0 : 1;\n    freq = 1200;\n} else {\n    flow.set('manualLampOverride', null);\n    flow.set('manualBuzzerOverride', null);\n}\nflow.set('lampState', lamp);\nflow.set('buzzerState', buzzer);\nflow.set('freq', freq);\n\nconst acts = '💡 Lampe ' + (lamp ? 'ON' : 'OFF') + ' · 🔊 Buzzer ' + (buzzer ? 'ON' : 'OFF');\nconst txt = active\n    ? '🚨 ALERTE — ' + bpm + ' BPM ≥ ' + threshold\n    : '✅ Alarme inactive — ' + bpm + ' BPM < ' + threshold;\nreturn [\n    { payload: 'lamp=' + lamp + ';buzzer=' + buzzer + ';frequency=' + freq },\n    { payload: txt },\n    { payload: acts }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1030,
        "y": 500,
