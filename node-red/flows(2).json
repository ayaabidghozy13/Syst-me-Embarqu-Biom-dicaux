    {
        "id": "73302fd87fb2ad63",
        "type": "function",
        "z": "d5f84fe3c1ba01d0",
        "name": "Arduino connection + session",
        "func": "// En ligne = message de statut (heartbeat Arduino toutes les 2 s)\n//            OU échantillons ECG reçus pendant les 5 dernières secondes.\nconst now = Date.now();\nconst UNKNOWN = '⚪ Session inconnue';\nlet sessionTxt = null;\n\nif (msg.topic === 'health/status') {\n    const p = String(msg.payload ?? '').trim();\n    const off = /deconnect|offline|disconnected/i.test(p);\n    context.set('lastSeen', off ? 0 : now);\n    const labels = {\n        'attente badge':        '🪪 En attente d’un badge',\n        'patient identifie':    '✅ Patient identifié — appuyez sur le bouton',\n        'acquisition en cours': '▶️ Acquisition en cours'\n    };\n    sessionTxt = off ? UNKNOWN : (labels[p.toLowerCase()] || p);\n} else if (msg.topic === 'heartbeat') {\n    context.set('lastSeen', now);\n}\n\nconst isOn = now - (context.get('lastSeen') || 0) < 5000;\nif (!isOn) sessionTxt = UNKNOWN;\n\nlet statusMsg = null;\nif (context.get('online') !== isOn) {\n    context.set('online', isOn);\n    statusMsg = { payload: isOn ? '🟢 Arduino connecté' : '🔴 Arduino déconnecté' };\n}\n\nlet sessionMsg = null;\nif (sessionTxt !== null && context.get('session') !== sessionTxt) {\n    context.set('session', sessionTxt);\n    sessionMsg = { payload: sessionTxt };\n}\n\nif (!statusMsg && !sessionMsg) return null;\nreturn [statusMsg, sessionMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
