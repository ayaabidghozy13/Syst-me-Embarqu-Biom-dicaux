    {
        "id": "2632ae381f3d4450",
        "type": "function",
        "z": "d5f84fe3c1ba01d0",
        "name": "Button event (start/stop/refused)",
        "func": "// Événements envoyés par l'Arduino : start / stop / refused\nconst p = String(msg.payload ?? '').trim().toLowerCase();\nif (!p) return null;\nconst t = new Date().toLocaleTimeString('fr-FR', { timeZone: 'Europe/Paris' });\nconst labels = {\n    start:   '▶️ Acquisition démarrée à ',\n    stop:    '⏹️ Acquisition arrêtée à ',\n    refused: '⛔ Badge requis — appui ignoré à ',\n    pressed: '🔘 Appuyé à '\n};\nconst txt = { payload: (labels[p] || '🔘 ' + p + ' — ') + t };\n\n// Sorties : 1 texte bouton, 2 commande MQTT, 3 alarme, 4 actionneurs,\n//           5 jauge BPM, 6 électrodes, 7 graphique ECG\nif (p === 'start') {\n    flow.set('ecgState', null);\n    return [txt, null, null, null, null,\n            { payload: '⏳ Attente du signal…' },\n            { payload: [] }];              // efface le graphique\n}\n\nif (p === 'stop') {\n    // Fin de session : on remet l'alarme et les actionneurs à zéro.\n    flow.set('ecgState', null);\n    flow.set('alarmActive', false);\n    flow.set('manualLampOverride', null);\n    flow.set('manualBuzzerOverride', null);\n    flow.set('lampState', 0);\n    flow.set('buzzerState', 0);\n    flow.set('freq', 600);\n    return [txt,\n            { payload: 'lamp=0;buzzer=0;frequency=600' },\n            { payload: '✅ Alarme inactive' },\n            { payload: '💡 Lampe OFF · 🔇 Buzzer OFF' },\n            { payload: 0 },\n            { payload: '⏸️ Acquisition arrêtée' },\n            null];\n}\n\nreturn [txt, null, null, null, null, null, null];",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
