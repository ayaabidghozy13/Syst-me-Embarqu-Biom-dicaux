        "ui": "",
        "name": "Patient card (icon + RFID)",
        "order": 1,
        "width": 6,
        "height": 6,
        "head": "",
        "format": "<template>\n  <div class=\"pt-card\">\n    <!-- Icône patient originale (SVG) -->\n    <svg class=\"pt-icon\" viewBox=\"0 0 120 120\" aria-label=\"Patient\">\n      <circle cx=\"60\" cy=\"60\" r=\"58\" fill=\"#ecfdf5\"/>\n      <path d=\"M22 118 C22 90 38 78 60 78 C82 78 98 90 98 118 Z\" fill=\"#7dd3fc\"/>\n      <path d=\"M22 118 C22 90 38 78 60 78 C82 78 98 90 98 118 Z\" fill=\"url(#pt-dots)\"/>\n      <rect x=\"53\" y=\"66\" width=\"14\" height=\"14\" rx=\"5\" fill=\"#f2c9a0\"/>\n      <circle cx=\"60\" cy=\"50\" r=\"20\" fill=\"#f6d2ae\"/>\n      <path d=\"M40 48 C40 32 52 27 62 28 C74 29 81 37 80 48 C75 40 67 37 58 38 C50 38 44 42 40 48 Z\" fill=\"#6b4a32\"/>\n      <circle cx=\"53\" cy=\"52\" r=\"2.2\" fill=\"#1e293b\"/>\n      <circle cx=\"67\" cy=\"52\" r=\"2.2\" fill=\"#1e293b\"/>\n      <path d=\"M54 60 Q60 65 66 60\" stroke=\"#1e293b\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n      <!-- bracelet d'identification -->\n      <rect x=\"70\" y=\"96\" width=\"26\" height=\"16\" rx=\"4\" fill=\"#ffffff\" stroke=\"#0ea5e9\" stroke-width=\"2\"/>\n      <path d=\"M75 101 H91 M75 106 H86\" stroke=\"#0ea5e9\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <defs>\n        <pattern id=\"pt-dots\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\">\n          <circle cx=\"5\" cy=\"5\" r=\"1.4\" fill=\"#ffffff\" opacity=\"0.7\"/>\n        </pattern>\n      </defs>\n    </svg>\n\n    <div class=\"pt-label\">🧑‍⚕️ Patient</div>\n\n    <template v-if=\"p.uid\">\n      <div class=\"pt-uid\">🪪 {{ p.uid }}</div>\n      <div class=\"pt-meta\">Identifié à {{ p.time }}</div>\n      <div :class=\"['pt-badge', p.status]\">\n        {{ p.status === 'acquisition' ? '▶️ Acquisition en cours' : '✅ Identifié — appuyez sur le bouton' }}\n      </div>\n    </template>\n    <template v-else>\n      <div class=\"pt-uid pt-empty\">— Aucun patient —</div>\n      <div class=\"pt-meta\">Passez un badge RFID pour commencer</div>\n    </template>\n  </div>\n</template>\n\n<script>\nexport default {\n  computed: {\n    p() {\n      return (this.msg && this.msg.payload && typeof this.msg.payload === 'object')\n        ? this.msg.payload\n        : { uid: null };\n    }\n  }\n};\n</script>\n\n<style>\n.pt-card {\n  display: flex; flex-direction: column; align-items: center; justify-content: center;\n  gap: 8px; height: 100%; padding: 8px; text-align: center;\n}\n.pt-icon { width: 130px; height: 130px; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.12)); }\n.pt-label { font-size: 16px; color: #475569; font-weight: 600; }\n.pt-uid {\n  font-family: ui-monospace, Consolas, monospace; font-size: 24px; font-weight: 700;\n  color: #0f172a; background: #f1f5f9; border: 1px solid #dbe4ee;\n  border-radius: 10px; padding: 6px 16px; letter-spacing: 1px;\n}\n.pt-empty { font-family: inherit; font-size: 18px; color: #94a3b8; letter-spacing: 0; }\n.pt-meta { font-size: 13px; color: #64748b; }\n.pt-badge { font-size: 14px; font-weight: 600; padding: 4px 12px; border-radius: 999px; }\n.pt-badge.identifie { background: #dcfce7; color: #166534; }\n.pt-badge.acquisition { background: #e0f2fe; color: #075985; }\n</style>",
